   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "ふみをろすあらしも猶やこほるらんをとこてかぬる春の山水",
   "kana": "",
   "speaker": "義教",
   "page": 1,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春水",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "春日野やまた春むゝきこいたつまわへおは色も雪にこもれる",
   "kana": "",
   "speaker": "公保",
   "page": 1,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "若草",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "尤は猶まこき木陰のすみれ草津世まてけふも野へにくらしつ",
   "kana": "",
   "speaker": "実量",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野遊",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "長閑なる雲井の庭にとる弓のかへりあるしを又やいそかむ",
   "kana": "",
   "speaker": "雅世",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "賭射",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "なれも今妻やこもれるむさし野にきゝすなくなり春の夕暮",
