   "speaker": "宗継",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雉子",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "春かすみたつ空くらきなるみ野によとこたつぬる夕ひはり哉",
   "kana": "",
   "speaker": "実雅",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雲雀",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "長閑なる比とや人もあそふ、いとのなかき春日を野へにくらして",
   "kana": "",
   "speaker": "定親",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遊絲",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "めなれつる四方の梢もかす見つゝ明ほのとをき巻のいろかな",
   "kana": "",
   "speaker": "特之",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春曙",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "さきやらぬ尤まつ比やいと猶くるゝもをそき日影なるらん",
   "kana": "",
   "speaker": "実勝",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "達日",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "古里の花にしはしとやすらひて行こそやらぬしか又山こへ",
   "kana": "",
   "speaker": "資任",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "志賀山越",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "君か代に三千たひめくれ見ちとせに花さくものけふの盃",
   "kana": "",
   "speaker": "雅親",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "三月三日",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "せきいるゝ苗代水にすむかはすなれも心やむたになるらし",
   "kana": "",
   "speaker": "公綱",
   "page": 2,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蛙",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "藪はてゝ花もにほはす成にけり今やなこりの春の古里",
   "kana": "",
   "speaker": "特賢",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残春",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "おもひいつる心の花そ猶ちらぬむめも桜も若葉なれとも",
   "kana": "",
   "speaker": "悲貴",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "新樹",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "もへ出し草の若葉もしけりあひて夏ふかくなる野人の毛哉",
   "kana": "",
   "speaker": "特春",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "新樹",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "もろかつらけふにあふひのむかしよりいく世かけこしかとし成説",
   "kana": "",
   "speaker": "教親",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "賀茂祭教親",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "心なき鵜舟なりともこの神のいけるをはなつあはよく羅し",
   "kana": "",
   "speaker": "満政",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵜川",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "衣手に露はを遣ても夜もすからねやへもいらすすゝむ比かな",
   "kana": "",
   "speaker": "貞国",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏夜",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "なれきつる花の色香も夏たけぬふけや山風たもとすゝしく",
   "kana": "",
   "speaker": "瑞禅",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏衣",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "草木たになひかぬほとにあつき日もあふきなりに風はすゝしき",
   "kana": "",
   "speaker": "道へ",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "扇",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "をく露も光をかはすはななから契りいやしき宿の夕かほ",
   "kana": "",
   "speaker": "義一",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕顔",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "いも決山抱ふたち過てなる神も中をはさけぬ雲そ時ゆく",
   "kana": "",
   "speaker": "雅世",
   "page": 3,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "晩立雅世晩立",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "一袖にもる露は涙か雨すきて蝉なきつて杜のしたみち",
   "kana": "",
   "speaker": "持賢",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "草",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "あふきを共またうちをかぬ秋の色や庭の草葉の露にはまし",
   "kana": "",
   "speaker": "公保",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残暑",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "をく霞の玉の緒ことにかよひきて秋風すたし星合の空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "乞巧奠",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "草かくれ身ひわつやとすとことはたなにをうつてのきのみ鳴覧",
   "kana": "",
   "speaker": "義一",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鶴",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "夜もすかち野分あれつる名残もやけ朝は草木の露も残らす",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野分",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "むら雨の雲もみたれて秋の田の草のめしらむ稲毒のかけ",
   "kana": "",
   "speaker": "雅世",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "稲妻",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "たれか又たへて聞らむ秋ふかみ慎こつ此のをくの村雨",
   "kana": "",
   "speaker": "宗縄",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋雨",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "もろし散る木々の土の葉もそれなから秋かけりこる野人の夕寄",
   "kana": "",
   "speaker": "実雅",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋夕",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "を山田のいな葉は雲のはこてにもあまつ空なる秋露そふく",
   "kana": "",
   "speaker": "定親",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋田",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "夕されは沢辺の秋の寄けさも袖にしられて鴫屋たつらん",
   "kana": "",
   "speaker": "公綱",
   "page": 4,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鴫",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "よそまても氷をしける月かけになを広沢の地もこそ見れ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "広沢池眺望持之",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "紅葉すりころもしられて此かつのかきほの蔦も色にいつなり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "葛",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "つれもなくうすき椎のもみちかな時雨はいこしそめぬ物かは",
   "kana": "",
   "speaker": "雅親",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "柞",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "いくめくり千世をかさねん露の間によはひをのふと菊のさかつき",
   "kana": "",
   "speaker": "煕貴",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "九月九日",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "夜のまより軒はの竹に聞ゆなりはつ霜はらふ秋かめのこゑ",
   "kana": "",
   "speaker": "持春",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋霜",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "うきにしもとまる心の何あれはわかるゝ敵を今したふ羅無",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮秋",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "をのれともちりぬはかりにをく霜のまたぬあらしやこの葉吹覧",
   "kana": "",
   "speaker": "義へ",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "白妙に秋みし菊のむらさきに色をかへてもなとのこる羅華",
   "kana": "",
   "speaker": "道へ",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残菊",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "かはしつり尾尤か袖に今はとて霜にやつるゝ野辺の寒けさ",
   "kana": "",
   "speaker": "公保",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "枯野",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "それにのみふるとは見へて庭の花につもこぬ雪やみそれ成る説",
   "kana": "",
   "speaker": "実量",
   "page": 5,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霊",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "はし鷹のをふさのすとのふりにけるかた野の御幸諸のこさはや",
   "kana": "",
   "speaker": "雅親",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野行幸",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "日影はす木するにこほる朝霜のてけてつゆけき松の下くさ",
   "kana": "",
   "speaker": "実親",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒松",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "をちつえる木のはも庵も埋れては凌めする庭の雪かな",
   "kana": "",
   "speaker": "雅世",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬朝",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "くち屋々惣藤葉のかへに腐るなり霜もつれなき谷のしゐ柴",
   "kana": "",
   "speaker": "教親",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "椎柴",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "風をいたみかをぬるねやのふする哉なるししあふきも恨むはかりに",
   "kana": "",
   "speaker": "瑞禅",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一食",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "一柏なしの御酒のさかつきとり〳〵に名もあらはれぬ雲の上人",
   "kana": "",
   "speaker": "宗継",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "仏名",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "こひはむるなみこは袖のはつしくれやかて思ひや色に出なん",
   "kana": "",
   "speaker": "道具",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初恋",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "くるしくそおもひ入ぬち見ちのくにありといふなる山の名もうし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍恋",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "よそにのみきくの籬の花の色をへたてぬ中も見るよしも哉",
   "kana": "",
   "speaker": "公保",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞恋",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "いかにせんめにかゝるよりあま雲のへこりをめにたにはれぬ思ひを",
   "kana": "",
   "speaker": "実豊",
   "page": 6,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見恋",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "思そめし心にもひて同わひ悪人には忍ふ人の返〳〵ゑを",
   "kana": "",
   "speaker": "雅世",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋忘",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "いのりこしはつ瀬の山の鐘の手を巻か衣々の空にき〳〵らん",
   "kana": "",
   "speaker": "宗継",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祈恋",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "きえやら思命のたれかこその葉にかゝるは露のちきりなからむ",
   "kana": "",
   "speaker": "実雅",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "契恋",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "よしやとてまたれぬほとはつらからて人たのめ成中そくるしき",
   "kana": "",
   "speaker": "定親",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待恋",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "ましをへてあひみぬわきの恨をもこよひするゝ心よはさよ",
   "kana": "",
   "speaker": "特之",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "会恋",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "いく夜かは鳥かなく音をあるつきのつらき別にかこちきぬらん",
   "kana": "",
   "speaker": "実勝",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "別照",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "契りさへあさむのきこすねにたてゝかくれもはてぬわか思ひかな",
   "kana": "",
   "speaker": "資任",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "顕応",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "七夕は年に一夜とこのむらんうはの空なる身の契りかな",
   "kana": "",
   "speaker": "特賢",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "稀恋",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "そのまゝにかよはぬ中のかたみとて袖にそのこす道しはのつゆ",
   "kana": "",
   "speaker": "雅親",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶恋",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "なをさりにおもひ返さぬからみかなふさと吹ぬるくすの秋かな",
   "kana": "",
   "speaker": "雅世",
   "page": 7,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "怨恋",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "したひわひ恨みかねつらいてたひか又は恋しきとしつもる説",
   "kana": "",
   "speaker": "悲貴",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旧恋",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "和かれろのつゝきはしらす恋わひてねぬよのまゝの横雲の空",
   "kana": "",
   "speaker": "持春",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁恋",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "夕くれはもしやと思ふたのみこにしらぬあしたの御こそ物うき",
   "kana": "",
   "speaker": "定親",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝恋",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "とことはにしほくむあまの堂くひとやひかにもなみの浦風",
   "kana": "",
   "speaker": "持之",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尽意",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "いりあひのかねてたのめぬ契だにゆふへはつらき心つくしを",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕恋",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "うちもねは恋すると人や思はまし夜こそ恋のまさるならひを",
   "kana": "",
   "speaker": "実雅",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜恋",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "こひしさはむかしにのみそならひこしあらぬ物思ふ尤のね覚に",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "老恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "たのまめやはつかに見つるはつ草の老行す錦の義き契りを",
   "kana": "",
   "speaker": "瑞禅",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "幼恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "うき中は遠山とりのちきりのみかさなるみねをへたへたそふる",
   "kana": "",
   "speaker": "満政",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠慈",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "へまくはかりなれてかひなき門か袖の露ももらさむ人つてそなき",
   "kana": "",
   "speaker": "貞国",
   "page": 8,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "近慮",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "たひころも夢にも思ふ人はこて草のまくらをとふあらし哉",
   "kana": "",
   "speaker": "実量",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "なみたとふ袖によかれぬ月かけのわかまつ人のかゝらましかは",
   "kana": "",
   "speaker": "道〻",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄月恋寄月恋道〻",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "袖のうへは雨とふりて意晴やらぬゐもひや空の雲と成なん",
   "kana": "",
   "speaker": "公保",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雲恋公保寄雲恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "うき巾は相坂山もこえやにてあらしは風や身をしゆるらん",
   "kana": "",
   "speaker": "雅世",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄風恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "よひのまの雨にも人のこくり前はいてはれゆく空やまたれん",
   "kana": "",
   "speaker": "実勝",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雨恋",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "風をいたみなもはぬかたになひかすに我しにもへの煙りはかりは",
   "kana": "",
   "speaker": "雅親",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄煙恋",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "宇々みてもいを立よらむかゝみ山わかうき中の影やうはると",
   "kana": "",
   "speaker": "公綱",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄山ゑ",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "あをからぬをもひは同し渡つまの見かめになとかよそになか覧",
   "kana": "",
   "speaker": "定親",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄海恋",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "つときにてしつむ瀬もなき身さへ猶うき中川の水のうたかね",
   "kana": "",
   "speaker": "持賢",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄河恋",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "逢坂屋越てハつらき別れ路をしはしとゝむか関守もかな",
   "kana": "",
   "speaker": "実量",
   "page": 9,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄買の",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "身にあまるなみたの川の逢瀬には稀にもかけぬ夢のうき橋",
   "kana": "",
   "speaker": "持春",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄橋照",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "いかゝせむ堂ねまきそめし松もひ草木るゝともなく茂るつらさを",
   "kana": "",
   "speaker": "教親",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄草恋",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "色かはる人はこすゑの秋露に松の名をからわれそつれなき",
   "kana": "",
   "speaker": "実雅",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木丞",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "あふさかや布み見ぬ中に鳥かねのうからぬをうき契とをしれ",
   "kana": "",
   "speaker": "持之",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鳥恋",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "飛とりのみ布すゐのかるもかきくへてそはれぬ中を恨みわひつゝ",
   "kana": "",
   "speaker": "満政",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄獣恋",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "うらみしな正せの多くもにすむ虫のきに名もしる身をこかす哉",
   "kana": "",
   "speaker": "雅親",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄虫恋",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "たかかたにふく笛津のよとともにしのひてこてぬ音をかはすてむ",
   "kana": "",
   "speaker": "貞国",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄笛恋",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "遊て舟の跡の波かはつなて野はひくことのねにしたふたもとは",
   "kana": "",
   "speaker": "凞貴",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄琴恋",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "かきて見む人の心をうつし絵にはかなき筆のすをみなりとも",
   "kana": "",
   "speaker": "瑞禅",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄絵恋",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "あけは又たもひの色も見へやを舞涙かさぬる夜半の衣手",
   "kana": "",
   "speaker": "教親",
   "page": 10,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄衣恋",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "つれもなき人の心のあやむしろをはなるなりしきしのへはや",
   "kana": "",
   "speaker": "公保",
   "page": 11,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄席恋",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "はかなしやむろのとまりの梶枕うきてねしよの契りはかりは",
   "kana": "",
   "speaker": "雅世",
   "page": 11,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄遊女恋",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "宇地愁をしかはのあまのいたつるに見るめもなきにぬるゝ袖哉",
   "kana": "",
   "speaker": "道へ",
   "page": 11,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄海人恋",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "しられしな契りさためぬうかれてうかれてはよふ心ありとも",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄傀儡丞宗継",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "山かつのおもふつま木はいかならんわれは三りはてぬ人のこゝろに",
   "kana": "",
   "speaker": "義は",
   "page": 11,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄樵夫樵",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "こらみてもかひやなからんか発ならぬ身をあき人の心と思へは",
   "kana": "",
   "speaker": "資任",
   "page": 11,
   "pid": "nao-733859",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄商人恋",
   "kotobagaki": ""
  }
 ],
