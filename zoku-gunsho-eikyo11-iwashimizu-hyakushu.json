   "dai": "元日宴",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "冬かてもさゝにそ海かふ峯の雪汀の氷はるさむくして",
   "kana": "",
   "speaker": "道二",
   "page": 1,
   "pid": "nao-733859",
